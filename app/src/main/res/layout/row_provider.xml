<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_row"
    android:layout_marginTop="6dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/stripe"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_stripe_clip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/text_provider_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_provider_cost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_surface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_provider_how"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_provider_sees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/severity_medium"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_provider_verdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/button_provider_copy"
            style="@style/Button.Adfection.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/provider_copy_link" />
    </LinearLayout>
</LinearLayout>
